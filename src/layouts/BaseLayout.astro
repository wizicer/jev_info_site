---
import SiteHeader from '../components/SiteHeader.astro';
import UseCaseCard from '../components/UseCaseCard.astro';
import CaseDialog from '../components/CaseDialog.astro';
import { demos, getDemoContext } from '../lib/content';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'jev.info — Use cases for fast, typed decisions',
  description = 'Explore real-world Jev use cases across software, games, robotics, research, and more.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const searchDemos = demos.map((demo) => {
  const { category, group } = getDemoContext(demo);
  return { ...demo, searchText: `${demo.description} ${demo.author.name} ${demo.author.handle} ${category?.enName ?? ''} ${group?.enName ?? ''}`.toLowerCase() };
});
const caseJson = JSON.stringify(demos).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f4" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2216%22 fill=%22%23171716%22/><text x=%2250%22 y=%2267%22 font-size=%2254%22 text-anchor=%22middle%22 fill=%22white%22 font-family=%22Arial%22>j</text></svg>" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('jev-theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      })();
    </script>
  </head>
  <body>
    <SiteHeader />
    <slot />

    <CaseDialog />

    <dialog class="search-dialog" aria-labelledby="search-title">
      <div class="search-bar">
        <h2 id="search-title">Search use cases</h2>
        <button class="search-close" type="button" aria-label="Close search">×</button>
        <label>
          <span class="sr-only">Search use cases</span>
          <input type="search" placeholder="Search descriptions, authors, or categories…" autocomplete="off" />
        </label>
        <p class="search-status">{searchDemos.length} use cases</p>
      </div>
      <div class="search-results">
        {searchDemos.map((demo) => <div data-search={demo.searchText}><UseCaseCard demo={demo} searchCard /></div>)}
      </div>
      <div class="search-empty" hidden>No use cases found.</div>
    </dialog>

    <script id="case-data" type="application/json" set:html={caseJson}></script>
    <script>
      import { initSite } from '../scripts/site';
      initSite();
    </script>
  </body>
</html>

<style is:global>
  dialog { color: var(--ink); }
  dialog::backdrop { background: rgb(8 9 8 / .66); backdrop-filter: blur(4px); }
  .search-dialog { width: 100%; max-width: none; height: 100%; max-height: none; margin: 0; padding: 0; border: 0; background: var(--paper); }
  .search-dialog::backdrop { background: var(--paper); }
  .search-close { position: absolute; z-index: 4; top: 18px; right: 18px; width: 40px; height: 40px; padding: 0; border: 1px solid var(--line); background: var(--surface); color: var(--ink); cursor: pointer; font-size: 26px; line-height: 1; }
  .search-bar { position: sticky; z-index: 3; top: 0; padding: 24px max(16px, calc((100% - 1480px) / 2)); border-bottom: 1px solid var(--line); background: var(--header); backdrop-filter: blur(14px); }
  .search-bar h2 { margin: 0 0 18px; font-size: 14px; font-weight: 650; }
  .search-bar label { display: block; padding-right: 55px; }
  .search-bar input { width: 100%; padding: 0 0 10px; border: 0; border-bottom: 1px solid var(--ink); border-radius: 0; outline: 0; background: transparent; color: var(--ink); font-size: clamp(25px, 4vw, 50px); letter-spacing: -.045em; }
  .search-bar input::placeholder { color: var(--muted); opacity: .55; }
  .search-status { margin: 10px 0 0; color: var(--muted); font-size: 11px; }
  .search-results { width: min(100% - 32px, 1480px); margin: 34px auto 80px; display: grid; grid-template-columns: 1fr; gap: 35px 18px; }
  .search-empty { padding: 80px 20px; text-align: center; color: var(--muted); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  @media (min-width: 620px) { .search-results { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 900px) { .search-results { width: min(100% - 64px, 1480px); grid-template-columns: repeat(3, minmax(0, 1fr)); gap-inline: 22px; } }
  @media (min-width: 1320px) { .search-results { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
  }
</style>


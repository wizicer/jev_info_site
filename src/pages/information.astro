---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Information — jev.info"><main class="soon"><span>Coming soon</span><h1>Information</h1><p>Background, references, and resources for the Jev ecosystem.</p></main></BaseLayout>
<style>.soon{min-height:calc(100dvh - 68px);padding:clamp(60px,12vw,180px) max(16px,calc((100% - 1480px)/2));}.soon span{color:var(--accent);font-size:11px;text-transform:uppercase;letter-spacing:.1em}h1{margin:15px 0;font-size:clamp(60px,13vw,190px);font-weight:580;line-height:.82;letter-spacing:-.08em}p{color:var(--muted);font-size:14px}</style>


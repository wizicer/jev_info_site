---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import awesomeData from '../data/awesome.json';

type Resource = { id: string; name: string; url: string; description: string };
const decodeName = (value: string) => value.replaceAll('&amp;', '&').replaceAll('&#x27;', "'").replaceAll('&quot;', '"');
const resources = [...(awesomeData as Resource[])].sort((a, b) => decodeName(a.name).localeCompare(decodeName(b.name), 'en'));
---

<BaseLayout title="Information — jev.info" description="References and community resources for the Jev ecosystem.">
  <main class="information-page shell">
    <header class="information-intro">
      <p>REFERENCE</p>
      <h1>Information</h1>
    </header>

    <section class="about-panel" aria-labelledby="about-heading">
      <div>
        <p class="section-label">01 / ABOUT JEV</p>
        <h2 id="about-heading">A practical introduction is on its way.</h2>
        <p>This section will explain what Jev is and how it is used.</p>
      </div>
      <div class="construction-mark" aria-label="Under construction"><Icon name="material-symbols:construction-rounded" size={30} aria-hidden="true" /></div>
    </section>

    <section class="resources" aria-labelledby="resources-heading">
      <div class="resources-heading">
        <div>
          <p class="section-label">02 / COMMUNITY RESOURCES</p>
          <h2 id="resources-heading">Useful places around Jev</h2>
        </div>
        <span>{resources.length} links</span>
      </div>
      <ul>
        {resources.map((resource) => (
          <li>
            <a href={resource.url} target="_blank" rel="noreferrer" title={decodeName(resource.name)}>
              <span>{decodeName(resource.name)}</span>
              <Icon name="material-symbols:arrow-outward-rounded" size={18} aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .information-page { padding-block: 58px 88px; }
  .information-intro { padding-bottom: 27px; border-bottom: 1px solid var(--ink); }
  .information-intro > p, .section-label { margin: 0 0 11px; color: var(--muted); font-size: 12px; font-weight: 760; letter-spacing: .15em; }
  h1, h2 { margin: 0; letter-spacing: -.055em; }
  h1 { font-size: clamp(28px, 4vw, 32px); }
  h2 { font-size: clamp(20px, 3vw, 26px); line-height: 1.13; }
  .about-panel { min-height: 212px; padding: 26px 0; display: flex; justify-content: space-between; gap: 28px; border-bottom: 1px solid var(--line); }
  .about-panel h2 { max-width: 480px; }
  .about-panel p:not(.section-label) { max-width: 440px; margin: 12px 0 0; color: var(--muted); line-height: 1.55; }
  .construction-mark { width: 76px; height: 76px; flex: none; display: grid; place-items: center; border: 1px solid var(--line); color: var(--muted); }
  .resources { margin-top: 58px; }
  .resources-heading { padding-bottom: 20px; display: flex; align-items: end; justify-content: space-between; gap: 20px; border-bottom: 1px solid var(--ink); }
  .resources-heading > span { flex: none; color: var(--muted); font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  ul { margin: 0; padding: 0; list-style: none; }
  li { border-bottom: 1px solid var(--line); }
  li a { min-height: 57px; padding: 12px 1px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  li a:hover { color: var(--accent); }
  li a span { overflow: hidden; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
  @media (max-width: 720px) { .information-page { padding-block: 38px 58px; } .about-panel { min-height: 190px; } .resources { margin-top: 42px; } }
</style>

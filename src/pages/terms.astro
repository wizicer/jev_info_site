---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocaleFromUrl, useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<BaseLayout title={`${t.terms.title} — jev.info`} description={t.terms.description} locale={locale}>
  <main class="shell policy-page">
    <p class="eyebrow">{t.terms.eyebrow}</p>
    <h1>{t.terms.title}</h1>
    <p class="lede">{t.terms.lede}</p>
    <section>
      <h2>{t.terms.communityTitle}</h2>
      <p>{t.terms.communityDesc}</p>
    </section>
    <section>
      <h2>{t.terms.contentTitle}</h2>
      <p>{t.terms.contentDesc}</p>
    </section>
    <section>
      <h2>{t.terms.externalTitle}</h2>
      <p>{t.terms.externalDesc}</p>
    </section>
    <section>
      <h2>{t.terms.warrantyTitle}</h2>
      <p>{t.terms.warrantyDesc}</p>
    </section>
    <section>
      <h2>{t.terms.changesTitle}</h2>
      <p>{t.terms.changesDesc}</p>
      <a class="action" href="https://github.com/wizicer/jev_info_site/issues/new?title=%5BContact%5D%20Terms%20question&body=Please%20describe%20your%20question%20about%20the%20jev.info%20terms." target="_blank" rel="noreferrer">{t.terms.askAction}</a>
    </section>
  </main>
</BaseLayout>

<style>
  .policy-page { min-height: 66vh; padding-block: 76px 110px; }
  .eyebrow { margin: 0 0 12px; color: var(--muted); font-size: 12px; font-weight: 720; letter-spacing: .15em; text-transform: uppercase; }
  h1 { max-width: 760px; margin: 0; font-size: clamp(26px, 4vw, 32px); letter-spacing: -.045em; }
  .lede { max-width: 720px; margin: 20px 0 52px; color: var(--muted); font-size: 16px; line-height: 1.7; }
  section { max-width: 720px; padding: 28px 0; border-top: 1px solid var(--line); }
  h2 { margin: 0 0 12px; font-size: 18px; }
  section p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.7; }
  .action { display: inline-block; margin-top: 22px; color: var(--accent); font-size: 14px; font-weight: 700; }
</style>

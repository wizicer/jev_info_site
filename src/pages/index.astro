---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import UseCaseCard from '../components/UseCaseCard.astro';
import { demos, demosForGroup, groups } from '../lib/content';

const recent = [...demos]
  .sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime())
  .slice(0, 8);
const latestDate = new Date(Math.max(...demos.map((demo) => new Date(demo.createdAt).getTime())));
const updated = new Intl.DateTimeFormat('en', {
  month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC',
}).format(latestDate);
---

<BaseLayout title="jev.info — The independent Jev information index">
  <main>
    <section class="shell hero">
      <p class="eyebrow">An independent community index</p>
      <h1>The independent index of Jev projects and use cases.</h1>

      <div class="stats" aria-label="Catalog statistics">
        <div><strong>{demos.length}</strong><span>Use cases</span></div>
        <div><strong class="date">{updated}</strong><span>Latest post</span></div>
      </div>

      <button class="hero-search home-search-trigger" type="button" aria-label="Search the Jev use case collection">
        <Icon name="material-symbols:search-rounded" size={35} />
        <span class="search-placeholder">What are you looking for?</span>
        <span class="search-action">Search <span aria-hidden="true">→</span></span>
      </button>

      <div class="collection-links" aria-label="Use case collections">
        {groups.map((group) => (
          <a href={'/use-cases/' + group.code}>
            <span>{group.enName}</span>
            <small>{demosForGroup(group).length}</small>
          </a>
        ))}
      </div>
      <a class="browse-all" href="/use-cases">Browse all use cases <span aria-hidden="true">→</span></a>
    </section>

    <section class="recent shell" aria-labelledby="recent-title">
      <div class="recent-heading">
        <div><span>Latest additions</span><h2 id="recent-title">Recent</h2></div>
        <a href="/use-cases">View all use cases ↗</a>
      </div>
      <div class="recent-grid">{recent.map((demo, index) => <UseCaseCard demo={demo} eager={index < 2} />)}</div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero { padding-top: clamp(44px, 6vw, 82px); padding-bottom: clamp(58px, 7vw, 90px); }
  .eyebrow { margin: 0 0 18px; color: var(--accent); font-size: 12px; font-weight: 720; letter-spacing: .12em; text-transform: uppercase; }
  h1 { max-width: 940px; margin: 0; font-size: clamp(26px, 3vw, 32px); font-weight: 560; line-height: .99; letter-spacing: -.065em; }
  .stats { width: min(100%, 700px); margin-top: clamp(32px, 4vw, 52px); display: grid; grid-template-columns: repeat(2, 1fr); border: 1px solid var(--ink); }
  .stats > div { min-height: 78px; padding: 15px 18px 14px; display: flex; flex-direction: column; justify-content: space-between; border-right: 1px solid var(--line); }
  .stats > div:last-child { border-right: 0; }
  .stats strong { font-size: clamp(19px, 2vw, 24px); line-height: 1; letter-spacing: -.045em; }
  .stats strong.date { font-size: clamp(17px, 1.8vw, 22px); letter-spacing: -.03em; }
  .stats span { color: var(--muted); font-size: 12px; font-weight: 720; letter-spacing: .09em; text-transform: uppercase; }
  .hero-search { width: 100%; margin-top: 24px; min-height: 68px; padding: 8px 8px 8px 18px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 14px; border: 1px solid var(--ink); background: transparent; color: var(--ink); text-align: left; cursor: pointer; transition: border-color .15s, box-shadow .15s; }
  .hero-search:hover, .hero-search:focus-visible { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); outline: 0; }
  .search-placeholder { color: var(--muted); font-size: 16px; letter-spacing: -.015em; opacity: .72; }
  .search-action { height: 50px; padding-inline: 24px; display: inline-flex; align-items: center; background: var(--ink); color: var(--paper); font-size: 12px; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  .search-action span { margin-left: 16px; font-size: 18px; }
  .collection-links { margin-top: 35px; display: flex; flex-wrap: wrap; gap: 10px; }
  .collection-links a { min-width: 150px; padding: 14px 16px; border: 1px solid var(--ink); display: inline-flex; align-items: center; justify-content: space-between; gap: 18px; font-size: 12px; font-weight: 720; letter-spacing: .06em; text-transform: uppercase; transition: background .15s, color .15s; }
  .collection-links small { color: var(--muted); font-size: 12px; font-weight: 600; letter-spacing: 0; transition: color .15s; }
  .collection-links a:hover { background: var(--ink); color: var(--paper); }
  .collection-links a:hover small { color: var(--paper); }
  .browse-all { width: fit-content; margin-top: 18px; padding: 8px 0; display: inline-flex; align-items: center; color: var(--accent); font-size: 14px; font-weight: 650; }
  .browse-all span { margin-left: 10px; font-size: 18px; }
  .recent { padding-bottom: 105px; }
  .recent-heading { padding: 28px 0 26px; border-top: 1px solid var(--line); display: flex; align-items: flex-end; justify-content: space-between; }
  .recent-heading span { color: var(--muted); font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  h2 { margin: 8px 0 0; font-size: clamp(26px, 3vw, 32px); font-weight: 560; line-height: .9; letter-spacing: -.065em; }
  .recent-heading a { color: var(--accent); font-size: 12px; }
  .recent-grid { display: grid; grid-template-columns: 1fr; gap: 34px 18px; }
  @media (min-width: 620px) { .recent-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 900px) { .recent-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap-inline: 22px; } }
  @media (min-width: 1320px) { .recent-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .stats > div { min-height: 76px; padding: 14px; }
    .hero-search { min-height: 62px; padding: 7px 7px 7px 14px; gap: 9px; }
    .search-action { width: 48px; height: 48px; padding: 0; justify-content: center; font-size: 0; }
    .search-action span { margin: 0; font-size: 20px; }
    .recent-grid > :nth-child(n + 5) { display: none; }
    .collection-links { margin-top: 24px; }
    .collection-links a { flex: 1 1 calc(50% - 10px); text-align: center; }
  }
</style>


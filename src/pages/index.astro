---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import UseCaseCard from '../components/UseCaseCard.astro';
import { categories, demos, groups } from '../lib/content';

const recent = [...demos]
  .sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime())
  .slice(0, 8);
const usedCategories = new Set(demos.map((demo) => demo.category));
const categoryCount = categories.filter((category) => usedCategories.has(category.code)).length;
const latestDate = new Date(Math.max(...demos.map((demo) => new Date(demo.createdAt).getTime())));
const updated = new Intl.DateTimeFormat('en', {
  month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC',
}).format(latestDate);
---

<BaseLayout title="jev.info — The independent Jev information index">
  <main>
    <section class="shell hero">
      <p class="eyebrow">An independent community index</p>
      <h1>Collecting the people, projects, and real-world use cases around Jev.</h1>

      <div class="stats" aria-label="Catalog statistics">
        <div><strong>{demos.length}</strong><span>Use cases</span></div>
        <div><strong>{categoryCount}</strong><span>Categories</span></div>
        <div><strong>{groups.length}</strong><span>Collections</span></div>
        <div><strong class="date">{updated}</strong><span>Catalog updated</span></div>
      </div>

      <form class="hero-search" role="search">
        <Icon name="material-symbols:search-rounded" size={35} />
        <label for="home-search">Search the Jev use case collection</label>
        <input id="home-search" type="search" placeholder="What are you looking for?" autocomplete="off" />
        <button type="submit">Search <span aria-hidden="true">→</span></button>
      </form>

      <div class="collection-links" aria-label="Use case collections">
        {groups.map((group) => <a href={'/use-cases/' + group.code}>{group.enName}</a>)}
      </div>
      <a class="browse-all" href="/use-cases">Browse all use cases <span aria-hidden="true">→</span></a>
    </section>

    <section class="recent shell" aria-labelledby="recent-title">
      <div class="recent-heading">
        <div><span>Latest additions</span><h2 id="recent-title">Recent</h2></div>
        <a href="/use-cases">View all use cases ↗</a>
      </div>
      <div class="recent-grid">{recent.map((demo, index) => <UseCaseCard demo={demo} eager={index < 2} />)}</div>
    </section>
  </main>
  <footer>
    <div class="shell footer-inner">
      <strong>jev.info</strong><span>Independent community reference</span><a href="/use-cases">Explore all use cases ↗</a>
    </div>
  </footer>
</BaseLayout>

<style>
  .hero { padding-top: clamp(55px, 8vw, 118px); padding-bottom: clamp(70px, 9vw, 125px); }
  .eyebrow { margin: 0 0 18px; color: var(--accent); font-size: 10px; font-weight: 720; letter-spacing: .12em; text-transform: uppercase; }
  h1 { max-width: 940px; margin: 0; font-size: clamp(38px, 6vw, 78px); font-weight: 560; line-height: .99; letter-spacing: -.065em; }
  .stats { margin-top: clamp(45px, 7vw, 88px); display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--ink); }
  .stats > div { min-height: 118px; padding: 24px 26px 20px; display: flex; flex-direction: column; justify-content: space-between; border-right: 1px solid var(--line); }
  .stats > div:last-child { border-right: 0; }
  .stats strong { font-size: clamp(27px, 3vw, 40px); line-height: 1; letter-spacing: -.05em; }
  .stats strong.date { font-size: clamp(17px, 2vw, 25px); letter-spacing: -.035em; }
  .stats span { color: var(--muted); font-size: 10px; font-weight: 720; letter-spacing: .09em; text-transform: uppercase; }
  .hero-search { margin-top: 42px; min-height: 112px; padding: 14px 14px 14px 27px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 22px; border: 1px solid var(--ink); }
  .hero-search label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); }
  .hero-search input { min-width: 0; border: 0; outline: 0; background: transparent; color: var(--ink); font-size: clamp(20px, 3vw, 36px); letter-spacing: -.04em; }
  .hero-search input::placeholder { color: var(--muted); opacity: .72; }
  .hero-search button, .browse-all { border: 0; background: var(--ink); color: var(--paper); font-size: 12px; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  .hero-search button { height: 72px; padding-inline: 33px; cursor: pointer; }
  .hero-search button span, .browse-all span { margin-left: 16px; font-size: 18px; }
  .collection-links { margin-top: 35px; display: flex; flex-wrap: wrap; gap: 10px; }
  .collection-links a { padding: 15px 18px; border: 1px solid var(--ink); font-size: 11px; font-weight: 720; letter-spacing: .06em; text-transform: uppercase; transition: background .15s, color .15s; }
  .collection-links a:hover { background: var(--ink); color: var(--paper); }
  .browse-all { width: fit-content; margin-top: 26px; padding: 20px 24px; display: inline-flex; align-items: center; }
  .recent { padding-bottom: 105px; }
  .recent-heading { padding: 28px 0 26px; border-top: 1px solid var(--line); display: flex; align-items: flex-end; justify-content: space-between; }
  .recent-heading span { color: var(--muted); font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  h2 { margin: 8px 0 0; font-size: clamp(42px, 6vw, 82px); font-weight: 560; line-height: .9; letter-spacing: -.065em; }
  .recent-heading a { color: var(--accent); font-size: 12px; }
  .recent-grid { display: grid; grid-template-columns: 1fr; gap: 34px 18px; }
  footer { border-top: 1px solid var(--line); }
  .footer-inner { min-height: 128px; display: flex; align-items: center; justify-content: space-between; gap: 20px; font-size: 11px; }
  .footer-inner span { color: var(--muted); } .footer-inner a { color: var(--accent); }
  @media (min-width: 620px) { .recent-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 900px) { .recent-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap-inline: 22px; } }
  @media (min-width: 1320px) { .recent-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stats > div { min-height: 100px; padding: 19px; border-bottom: 1px solid var(--line); }
    .stats > div:nth-child(2) { border-right: 0; } .stats > div:nth-child(n+3) { border-bottom: 0; }
    .hero-search { min-height: 0; padding: 17px; grid-template-columns: auto 1fr; gap: 12px; }
    .hero-search button { grid-column: 1 / -1; width: 100%; height: 56px; }
    .collection-links a { flex: 1 1 calc(50% - 10px); text-align: center; }
    .footer-inner { padding-block: 32px; flex-direction: column; align-items: flex-start; }
  }
</style>


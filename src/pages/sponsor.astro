---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocaleFromUrl, useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<BaseLayout title={`${t.sponsor.title} — jev.info`} description={t.sponsor.description} locale={locale}>
  <main class="shell policy-page">
    <p class="eyebrow">{t.sponsor.eyebrow}</p>
    <h1>{t.sponsor.title}</h1>
    <p class="lede">{t.sponsor.lede}</p>
    <section>
      <h2>{t.sponsor.fundTitle}</h2>
      <p>{t.sponsor.fundDesc}</p>
    </section>
    <section>
      <h2>{t.sponsor.contactTitle}</h2>
      <p>{t.sponsor.contactDesc}</p>
      <a class="action" href="https://github.com/wizicer/jev_info_site/issues/new?title=%5BSponsor%5D%20Sponsorship%20enquiry&body=Please%20tell%20us%20a%20little%20about%20your%20organisation%20and%20how%20you%20would%20like%20to%20support%20jev.info." target="_blank" rel="noreferrer">{t.sponsor.contactAction}</a>
    </section>
  </main>
</BaseLayout>

<style>
  .policy-page { min-height: 66vh; padding-block: 76px 110px; }
  .eyebrow { margin: 0 0 12px; color: var(--muted); font-size: 12px; font-weight: 720; letter-spacing: .15em; text-transform: uppercase; }
  h1 { max-width: 760px; margin: 0; font-size: clamp(26px, 4vw, 32px); letter-spacing: -.045em; }
  .lede { max-width: 720px; margin: 20px 0 52px; color: var(--muted); font-size: 16px; line-height: 1.7; }
  section { max-width: 720px; padding: 28px 0; border-top: 1px solid var(--line); }
  h2 { margin: 0 0 12px; font-size: 18px; }
  section p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.7; }
  .action { display: inline-block; margin-top: 22px; color: var(--accent); font-size: 14px; font-weight: 700; }
</style>

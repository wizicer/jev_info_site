---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import modelsData from '../data/models.json';

type Model = { id: string; name: string; url: string; description: string };
const models = [...(modelsData as Model[])].sort((a, b) => a.name.localeCompare(b.name, 'en'));
---

<BaseLayout title="Models — jev.info" description="Models in the Jev ecosystem.">
  <main class="models-page shell">
    <header class="models-intro">
      <p>MODEL CATALOG</p>
      <h1>Models</h1>
      <span>{models.length} models</span>
    </header>
    <section class="model-grid" aria-label="Models">
      {models.map((model) => (
        <a class="model-card" href={model.url} target="_blank" rel="noreferrer">
          <div class="model-card-top">
            <h2>{model.name}</h2>
            <Icon name="material-symbols:arrow-outward-rounded" size={18} aria-hidden="true" />
          </div>
          <p class="line-clamp-3">{model.description}</p>
          <span class="model-source">{new URL(model.url).hostname.replace(/^www\./, '')}</span>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  .models-page { padding-block: 58px 88px; }
  .models-intro { padding-bottom: 27px; border-bottom: 1px solid var(--ink); display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 12px; }
  .models-intro > p { grid-column: 1 / -1; margin: 0; color: var(--muted); font-size: 12px; font-weight: 760; letter-spacing: .15em; }
  h1 { margin: 0; font-size: clamp(28px, 4vw, 32px); letter-spacing: -.055em; }
  .models-intro > span { color: var(--muted); font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .model-grid { display: grid; grid-template-columns: repeat(1, minmax(0, 1fr)); border-left: 1px solid var(--line); }
  .model-card { min-height: 212px; padding: 20px; display: flex; flex-direction: column; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--surface); transition: background .18s, color .18s; }
  .model-card:hover { background: var(--accent); color: var(--paper); }
  .model-card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; }
  h2 { margin: 0; font-size: 18px; line-height: 1.2; letter-spacing: -.03em; overflow-wrap: anywhere; }
  .model-card > p { margin: 18px 0 0; color: var(--muted); font-size: 13px; line-height: 1.5; transition: color .18s; }
  .model-card:hover > p, .model-card:hover .model-source { color: color-mix(in srgb, var(--paper) 82%, transparent); }
  .model-source { margin-top: auto; padding-top: 21px; color: var(--muted); font-size: 12px; font-weight: 650; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @media (min-width: 660px) { .model-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1020px) { .model-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 720px) { .models-page { padding-block: 38px 58px; } .model-card { min-height: 184px; } }
</style>

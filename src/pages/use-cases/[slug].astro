---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UseCaseCard from '../../components/UseCaseCard.astro';
import DetailContent from '../../components/DetailContent.astro';
import { demos, demosForCategory, demosForGroup, getDemoContext, groups } from '../../lib/content';
import type { Demo, Group } from '../../types';

export function getStaticPaths() {
  return [
    ...groups.map((group) => ({ params: { slug: group.code }, props: { kind: 'group', group } })),
    ...demos.map((demo) => ({ params: { slug: demo.id }, props: { kind: 'demo', demo } })),
  ];
}

const props = Astro.props as { kind: 'group'; group: Group } | { kind: 'demo'; demo: Demo };
const isGroup = props.kind === 'group';
const group = isGroup ? props.group : undefined;
const demo = !isGroup ? props.demo : undefined;
const context = demo ? getDemoContext(demo) : undefined;
const title = group ? `${group.enName} use cases — jev.info` : `Use case ${demo?.id} — jev.info`;
const description = demo?.description ?? `Explore ${group?.enName} use cases built with Jev.`;
const visibleCategories = group
  ? group.categories.filter((category) => demosForCategory(category.code).length > 0)
  : [];
---

<BaseLayout title={title} description={description}>
  {group ? (
    <main class="shell group-page">
      <header class="group-header">
        <a href="/use-cases">← All use cases</a>
        <p>{demosForGroup(group).length} examples</p>
        <h1>{group.enName}</h1>
      </header>
      <nav class="category-nav" aria-label="Categories in this group">
        {visibleCategories.map((category) => (
          <a href={`/use-cases/${group.code}#category-${category.code}`}>{category.enName}</a>
        ))}
      </nav>
      {visibleCategories.map((category) => {
        const items = demosForCategory(category.code);
        return items.length > 0 && (
          <section class="category-section" aria-labelledby={`category-${category.code}`}>
            <div class="category-heading">
              <h2 id={`category-${category.code}`}>{category.enName}</h2>
              <span>{items.length}</span>
            </div>
            <div class="category-grid">{items.map((item) => <UseCaseCard demo={item} />)}</div>
          </section>
        );
      })}
    </main>
  ) : demo ? (
    <main><DetailContent demo={demo} category={context?.category} group={context?.group} /></main>
  ) : null}
</BaseLayout>

<style>
  .group-page { padding-block: 40px 90px; }
  .group-header { padding: clamp(15px, 4vw, 55px) 0 clamp(34px, 5vw, 65px); }
  .group-header a, .group-header p { color: var(--muted); font-size: 12px; }
  .group-header p { margin: 45px 0 9px; text-transform: uppercase; letter-spacing: .1em; }
  h1 { max-width: 1050px; margin: 0; font-size: clamp(28px, 4vw, 32px); font-weight: 580; line-height: .84; letter-spacing: -.075em; }
  .category-nav { position: sticky; z-index: 20; top: 68px; margin-bottom: 22px; padding: 12px 0; display: flex; flex-wrap: nowrap; gap: 8px; overflow-x: auto; background: var(--paper); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); scrollbar-width: thin; }
  .category-nav a { flex: 0 0 auto; padding: 10px 12px; border: 1px solid var(--line); color: var(--muted); font-size: 12px; font-weight: 650; }
  .category-nav a:hover { border-color: var(--accent); color: var(--accent); }
  .category-nav a.active { border-color: var(--accent); background: var(--accent); color: var(--paper); }
  .category-nav a:focus-visible { border-color: var(--accent); }
  .category-section { padding: 28px 0 65px; border-top: 1px solid var(--line); }
  .category-heading { margin-bottom: 28px; display: flex; justify-content: space-between; align-items: baseline; }
  h2 { margin: 0; scroll-margin-top: 145px; font-size: clamp(22px, 2.5vw, 28px); font-weight: 590; letter-spacing: -.045em; }
  .category-heading span { color: var(--muted); font-size: 12px; }
  .category-grid { display: grid; grid-template-columns: 1fr; gap: 34px 18px; }
  @media (min-width: 620px) { .category-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 900px) { .category-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap-inline: 22px; } }
  @media (min-width: 1320px) { .category-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .category-nav { padding-right: 30px; -webkit-mask-image: linear-gradient(to right, #000 0, #000 calc(100% - 30px), transparent 100%); mask-image: linear-gradient(to right, #000 0, #000 calc(100% - 30px), transparent 100%); }
    .category-nav a { scroll-snap-align: start; }
  }
</style>


---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GroupSection from '../../components/GroupSection.astro';
import { demosForGroup, getLocalizedGroups } from '../../lib/content';
import { getLocaleFromUrl, useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const localizedGroups = getLocalizedGroups(locale);
---

<BaseLayout title={`${t.useCases.title} — jev.info`} description={t.useCases.subtitle} locale={locale}>
  <main class="shell home-main">
    <header class="directory-intro">
      <p class="eyebrow">CASE CATALOG</p>
      <h1>{t.useCases.title}</h1>
      <p>{t.useCases.subtitle}</p>
    </header>
    {localizedGroups.map((group) => <GroupSection group={group} demos={demosForGroup(group, locale)} locale={locale} />)}
  </main>
</BaseLayout>

<style>
  .home-main { padding-block: 58px 88px; }
  .directory-intro { max-width: 680px; margin-bottom: 34px; }
  .eyebrow { margin: 0 0 11px; color: var(--muted); font-size: 12px; font-weight: 760; letter-spacing: .15em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(28px, 4vw, 32px); letter-spacing: -.055em; }
  .directory-intro > p:last-child { max-width: 540px; margin: 13px 0 0; color: var(--muted); line-height: 1.6; }
  @media (max-width: 720px) {
    .home-main { padding-block: 38px 58px; }
  }
</style>


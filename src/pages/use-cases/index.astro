---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GroupSection from '../../components/GroupSection.astro';
import { demosForGroup, groups } from '../../lib/content';
---

<BaseLayout title="All use cases — jev.info">
  <main class="shell home-main">
    <div class="page-intro">
      <h1 class="page-title">Use cases</h1>
      <p>Real-world examples of fast, typed decisions.</p>
    </div>
    {groups.map((group) => <GroupSection group={group} demos={demosForGroup(group)} />)}
  </main>
</BaseLayout>

<style>
  .home-main { padding-top: clamp(28px, 4vw, 56px); }
  .page-intro { min-height: 72px; padding-bottom: 24px; display: flex; align-items: baseline; gap: 12px; font-size: 14px; }
  .page-intro p { margin: 0; color: var(--muted); }
  .page-intro h1,
  .page-title {
    margin: 0;
    padding: 0;
    font-size: 14px;
    font-weight: 700;
    line-height: inherit;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--ink);
    display: inline;
  }
  @media (max-width: 550px) { .page-intro { min-height: 86px; flex-direction: column; justify-content: flex-end; gap: 6px; } .page-intro p { line-height: 1.45; } }
</style>


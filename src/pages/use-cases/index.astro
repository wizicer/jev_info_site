---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GroupSection from '../../components/GroupSection.astro';
import { demosForGroup, groups } from '../../lib/content';
---

<BaseLayout title="All use cases — jev.info">
  <main class="shell home-main">
    <div class="page-intro">
      <p>Real-world examples of fast, typed decisions.</p>
      <span>Use cases</span>
    </div>
    {groups.map((group) => <GroupSection group={group} demos={demosForGroup(group)} />)}
  </main>
</BaseLayout>

<style>
  .home-main { padding-top: clamp(34px, 6vw, 88px); }
  .page-intro { min-height: 100px; padding-bottom: 32px; display: flex; align-items: flex-end; justify-content: space-between; color: var(--muted); font-size: 14px; }
  .page-intro p { margin: 0; } .page-intro span { text-transform: uppercase; letter-spacing: .06em; }
  @media (max-width: 550px) { .page-intro p { max-width: 190px; line-height: 1.45; } }
</style>


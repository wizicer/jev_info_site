---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GroupSection from '../../components/GroupSection.astro';
import { demosForGroup, groups } from '../../lib/content';
---

<BaseLayout title="All use cases — jev.info" description="Explore real-world Jev use cases across software, games, robotics, research, and more.">
  <main class="shell home-main">
    <header class="directory-intro">
      <p class="eyebrow">CASE CATALOG</p>
      <h1>Use cases</h1>
      <p>Real-world examples of fast, typed decisions.</p>
    </header>
    {groups.map((group) => <GroupSection group={group} demos={demosForGroup(group)} />)}
  </main>
</BaseLayout>

<style>
  .home-main { padding-block: 58px 88px; }
  .directory-intro { max-width: 680px; margin-bottom: 34px; }
  .eyebrow { margin: 0 0 11px; color: var(--muted); font-size: 12px; font-weight: 760; letter-spacing: .15em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(28px, 4vw, 32px); letter-spacing: -.055em; }
  .directory-intro > p:last-child { max-width: 540px; margin: 13px 0 0; color: var(--muted); line-height: 1.6; }
  @media (max-width: 720px) {
    .home-main { padding-block: 38px 58px; }
  }
</style>


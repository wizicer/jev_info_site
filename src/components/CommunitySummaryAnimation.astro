<script>
  const lines = ['{', '  "urgent": true,', '  "owner": "engineering",', '  "risk": "high",', '  "complete": false', '}'];
  const typewriter = document.querySelector<HTMLElement>('[data-typewriter]');
  if (typewriter) {
    const targets = [...typewriter.querySelectorAll<HTMLElement>('.json-line')];
    const characters = lines.reduce((total, line) => total + line.length, 0);
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cursor = typewriter.querySelector<HTMLElement>('.cursor');
    const segments = [...document.querySelectorAll<HTMLElement>('.token-progress i')];
    const startedAt = performance.now();
    const draw = (now: number) => {
      const elapsed = (now - startedAt) % 8000;
      const typingElapsed = Math.max(0, elapsed - 880);
      const visible = reducedMotion ? characters : Math.min(characters, Math.floor((typingElapsed / 5600) * characters));
      let remaining = visible;
      lines.forEach((line, index) => {
        const length = Math.min(line.length, Math.max(0, remaining));
        targets[index].textContent = line.slice(0, length) || '\u00a0';
        remaining -= line.length;
      });
      const progress = visible / characters;
      segments.forEach((segment, index) => segment.style.setProperty('--fill', progress * 8 >= index + 1 ? '1' : '0'));
      const activeIndex = Math.max(0, targets.findLastIndex((target) => target.textContent !== '\u00a0'));
      const activeLine = targets[activeIndex];
      if (cursor && activeLine) {
        const range = document.createRange();
        range.selectNodeContents(activeLine);
        const caret = range.getBoundingClientRect();
        const code = typewriter.getBoundingClientRect();
        cursor.style.left = `${Math.max(0, caret.right - code.left + 2)}px`;
        cursor.style.top = `${Math.max(0, caret.top - code.top + 1)}px`;
      }
      if (!reducedMotion) requestAnimationFrame(draw);
    };
    requestAnimationFrame(draw);
  }
</script>


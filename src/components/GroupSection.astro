---
import UseCaseCard from './UseCaseCard.astro';
import type { Demo, Group } from '../types';
const { group, demos } = Astro.props as { group: Group; demos: Demo[] };
---

<section class="group-section" aria-labelledby={`group-${group.code}`}>
  <div class="section-heading">
    <div>
      <span class="section-index">{group.categories.length} subcategories · {demos.length} use cases</span>
      <h2 id={`group-${group.code}`}><a href={`/use-cases/${group.code}`}>{group.enName}</a></h2>
    </div>
    <a href={`/use-cases/${group.code}`}>
      View all <span aria-hidden="true">↗</span>
    </a>
  </div>
  <div class="case-grid preview-grid">
    {demos.slice(0, 4).map((demo, index) => <UseCaseCard demo={demo} eager={index < 2} />)}
  </div>
</section>

<style>
  .group-section { border-top: 1px solid var(--line); padding: 25px 0 58px; }
  .section-heading { margin-bottom: 25px; display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; }
  .section-index { display: block; margin-bottom: 8px; color: var(--muted); font-size: 14px; font-weight: 650; letter-spacing: .06em; text-transform: uppercase; }
  h2 { margin: 0; font-size: clamp(24px, 2.5vw, 32px); font-weight: 610; line-height: .98; letter-spacing: -.055em; }
  h2 a { transition: color .15s; }
  h2 a:hover { color: var(--accent); }
  .section-heading > a { min-height: 40px; padding-left: 18px; display: inline-flex; align-items: center; color: var(--accent); font-size: 14px; white-space: nowrap; }
  .case-grid { display: grid; grid-template-columns: 1fr; gap: 30px 18px; }
  .preview-grid > :global(*:nth-child(n+3)) { display: none; }
  @media (min-width: 620px) { .case-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 900px) { .case-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap-inline: 22px; } .preview-grid > :global(*:nth-child(3)) { display: block; } }
  @media (min-width: 1320px) { .case-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } .preview-grid > :global(*:nth-child(4)) { display: block; } }
  @media (max-width: 619px) {
    .group-section { padding-block: 21px 40px; }
    .preview-grid > :global(*:nth-child(n+2)) { display: none; }
  }
</style>


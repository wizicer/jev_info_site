---
import type { Demo } from '../types';
const { demo, eager = false, searchCard = false } = Astro.props as { demo: Demo; eager?: boolean; searchCard?: boolean };
---

<a
  class:list={['use-case-card', { 'search-card': searchCard }]}
  href={`/use-cases/${demo.id}`}
  data-case-link
  data-id={demo.id}
  data-search={`${demo.description} ${demo.author.name} ${demo.author.handle}`.toLowerCase()}
>
  <div class="media-frame">
    <div class="media-fallback" aria-hidden="true"><span>jev</span></div>
    {demo.mediaType === 'video' ? (
      <video
        class="case-media case-video"
        src={demo.src}
        width={demo.width}
        height={demo.height}
        muted
        playsinline
        preload={eager ? 'metadata' : 'none'}
        aria-label={demo.description}
      />
    ) : (
      <img
        class="case-media"
        src={demo.src}
        width={demo.width}
        height={demo.height}
        loading={eager ? 'eager' : 'lazy'}
        alt=""
        data-fallback-media
      />
    )}
  </div>
  <p class="line-clamp-2">{demo.description}</p>
</a>

<style>
  .use-case-card { display: block; min-width: 0; }
  .media-frame { position: relative; overflow: hidden; aspect-ratio: 16 / 9; border: 1px solid var(--line); background: var(--surface-soft); }
  .media-fallback { position: absolute; inset: 0; display: grid; place-items: center; background: linear-gradient(135deg, var(--surface-soft), var(--surface)); color: var(--line); }
  .media-fallback::before { content: ''; position: absolute; inset: 13%; border: 1px solid currentColor; transform: rotate(-4deg); }
  .media-fallback span { font-weight: 750; font-size: clamp(24px, 3vw, 32px); letter-spacing: -.08em; }
  .case-media { pointer-events: none; position: relative; width: 100%; height: 100%; display: block; object-fit: cover; background: var(--surface-soft); transition: transform .35s ease, opacity .2s ease; }
  .use-case-card:hover .case-media { transform: scale(1.015); }
  p { min-height: 3em; margin: 13px 1px 0; color: var(--ink); font-size: 14px; line-height: 1.48; letter-spacing: -.01em; }
  @media (min-width: 1100px) { p { font-size: 14px; } }
</style>


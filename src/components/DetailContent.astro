---
import type { Demo } from '../types';
import type { Category, Group } from '../types';
import { formatDate } from '../lib/content';
const { demo, category, group } = Astro.props as { demo: Demo; category?: Category; group?: Group };
---

<article class="detail-layout">
  <div class="detail-media">
    <div class="fallback" aria-hidden="true">jev</div>
    {demo.mediaType === 'video' ? (
      <video src={demo.src} controls muted playsinline autoplay width={demo.width} height={demo.height} />
    ) : (
      <img src={demo.src} alt="" width={demo.width} height={demo.height} data-fallback-media />
    )}
  </div>
  <div class="detail-copy">
    <p class="taxonomy"><a href={`/use-cases/${group?.code}`}>{group?.enName}</a> <span>/</span> {category?.enName}</p>
    <p class="description">{demo.description}</p>
    <div class="author">
      <img src={demo.author.avatarUrl} alt="" width="44" height="44" />
      <div><strong>{demo.author.name}</strong><span>@{demo.author.handle}</span></div>
    </div>
    <dl>
      <div><dt>Published</dt><dd>{formatDate(demo.createdAt)}</dd></div>
      <div><dt>Source</dt><dd><a href={demo.url} target="_blank" rel="noreferrer">View original post ↗</a></dd></div>
    </dl>
    <div class="tweet-wrap">
      <blockquote class="twitter-tweet" data-dnt="true" data-theme="light"><a href={demo.url}>View the original post on X</a></blockquote>
    </div>
  </div>
</article>

<script is:inline src="https://platform.twitter.com/widgets.js" async charset="utf-8"></script>

<style>
  .detail-layout { display: grid; min-height: calc(100dvh - 68px); grid-template-columns: minmax(0, 1.55fr) minmax(350px, .8fr); }
  .detail-media { position: sticky; top: 68px; height: calc(100dvh - 68px); display: grid; place-items: center; overflow: hidden; background: #090a09; }
  .detail-media video, .detail-media img { position: relative; z-index: 1; width: 100%; height: 100%; object-fit: contain; }
  .fallback { position: absolute; color: #30322f; font-size: clamp(70px, 12vw, 170px); font-weight: 750; letter-spacing: -.08em; }
  .detail-copy { padding: clamp(42px, 6vw, 88px) clamp(24px, 4vw, 58px); }
  .taxonomy { margin: 0 0 28px; color: var(--muted); font-size: 11px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; }
  .taxonomy a { color: var(--accent); } .taxonomy span { margin-inline: 7px; }
  .description { margin: 0 0 38px; font-size: clamp(22px, 2.25vw, 34px); line-height: 1.28; letter-spacing: -.04em; }
  .author { display: flex; align-items: center; gap: 12px; padding: 20px 0; border-block: 1px solid var(--line); }
  .author img { width: 44px; height: 44px; border-radius: 50%; background: var(--surface-soft); }
  .author strong, .author span { display: block; font-size: 13px; } .author span { margin-top: 3px; color: var(--muted); }
  dl { margin: 0; } dl > div { display: grid; grid-template-columns: 100px 1fr; padding: 15px 0; border-bottom: 1px solid var(--line); font-size: 12px; }
  dt { color: var(--muted); } dd { margin: 0; } dd a { color: var(--accent); }
  .tweet-wrap { margin-top: 28px; min-height: 100px; }
  @media (max-width: 820px) {
    .detail-layout { display: block; }
    .detail-media { position: relative; top: 0; height: auto; aspect-ratio: 16 / 9; }
    .detail-copy { padding: 30px 18px 60px; }
  }
</style>


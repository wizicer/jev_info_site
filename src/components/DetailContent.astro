---
import type { Category, Demo, Group } from '../types';
import { formatDate } from '../lib/content';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  demo: Demo;
  category?: Category;
  group?: Group;
  locale?: Locale;
}

const { demo, category, group, locale: propLocale } = Astro.props;
const locale = propLocale ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const groupName = group?.name;
const categoryName = category?.name;
---

<article class="detail-layout" data-detail-root data-id={demo.id} data-src={demo.src} data-cover={demo.cover} data-media-type={demo.mediaType} data-url={demo.url}>
  <section class="detail-primary" aria-label={t.useCases.originalPost}>
    <span class="section-label">{t.useCases.originalPost}</span>
    <div class="tweet-status-bar" data-tweet-status role="status">
      <span class="tweet-status-spinner" aria-hidden="true"></span>
      <span class="tweet-status-text">{t.useCases.loadingPost}</span>
      <a class="tweet-status-link" href={demo.url} target="_blank" rel="noreferrer">{t.useCases.openOnX}</a>
    </div>
    <div class="detail-media" data-detail-media>
      <img src={demo.cover} alt={demo.description} />
    </div>
    <div class="standalone-tweet" data-standalone-tweet hidden></div>
  </section>
  <aside class="detail-copy">
    <p class="taxonomy"><a href={getLocalizedPath('/use-cases/' + group?.code, locale)}>{groupName}</a> <span>/</span> {categoryName}</p>
    <h1 class="description">{demo.description}</h1>
    <div class="author">
      <img src={demo.author.avatarUrl} alt="" width="44" height="44" />
      <div><strong>{demo.author.name}</strong><span>@{demo.author.handle}</span></div>
    </div>
    <dl>
      <div><dt>{t.useCases.published}</dt><dd>{formatDate(demo.createdAt, locale)}</dd></div>
      <div><dt>{t.useCases.source}</dt><dd><a href={demo.url} target="_blank" rel="noreferrer">{t.useCases.viewOriginalPost}</a></dd></div>
    </dl>
  </aside>
</article>

<script>
  const root = document.querySelector<HTMLElement>('[data-detail-root]');
  if (root) {
    const statusEl = root.querySelector<HTMLElement>('[data-tweet-status]');
    const statusText = statusEl?.querySelector<HTMLElement>('.tweet-status-text');
    const mediaEl = root.querySelector<HTMLElement>('[data-detail-media]');
    const host = root.querySelector<HTMLElement>('[data-standalone-tweet]')!;

    const showFallback = () => {
      if (statusEl) {
        statusEl.classList.add('is-failed');
        if (statusText) statusText.textContent = 'Original post unavailable · Showing preview';
      }
      if (mediaEl) mediaEl.hidden = false;
      if (host) {
        host.classList.remove('is-staging');
        host.hidden = true;
      }
    };

    type TwitterWindow = Window & {
      twttr?: {
        widgets: {
          createVideo: (id: string, host: HTMLElement, options: object) => Promise<HTMLElement | undefined>;
          createTweet: (id: string, host: HTMLElement, options: object) => Promise<HTMLElement | undefined>;
        };
      };
    };
    const twitterWindow = window as TwitterWindow;

    const loadTwitterScript = () => new Promise<void>((resolve) => {
      if (twitterWindow.twttr) return resolve();
      const existing = document.querySelector<HTMLScriptElement>('script[data-twitter-widget]');
      if (existing) {
        existing.addEventListener('load', () => resolve(), { once: true });
        existing.addEventListener('error', () => resolve(), { once: true });
        return;
      }
      const script = document.createElement('script');
      script.src = 'https://platform.twitter.com/widgets.js';
      script.async = true;
      script.dataset.twitterWidget = 'true';
      script.onload = () => resolve();
      script.onerror = () => resolve();
      document.head.append(script);
    });

    const load = async () => {
      const tweetId = root.dataset.id ?? '';
      if (!tweetId) {
        showFallback();
        return;
      }

      host.hidden = false;
      host.classList.add('is-staging');

      const tweetPromise = (async () => {
        try {
          await loadTwitterScript();
          if (!twitterWindow.twttr) return false;
          let result = await twitterWindow.twttr.widgets.createVideo(tweetId, host, { dnt: true });
          if (!result) {
            result = await twitterWindow.twttr.widgets.createTweet(tweetId, host, { dnt: true });
          }
          return !!result;
        } catch {
          return false;
        }
      })();

      const timeoutPromise = new Promise<boolean>((resolve) => setTimeout(() => resolve(false), 10000));
      const ok = await Promise.race([tweetPromise, timeoutPromise]);

      if (ok) {
        if (statusEl) statusEl.classList.add('is-loaded');
        if (mediaEl) mediaEl.hidden = true;
        host.classList.remove('is-staging');
      } else {
        showFallback();
      }
    };
    load();
  }
</script>

<style>
  .detail-layout { min-height: calc(100dvh - 68px); display: grid; grid-template-columns: minmax(520px, 1.5fr) minmax(320px, .75fr); }
  .detail-primary { padding: 32px; display: flex; flex-direction: column; align-items: center; background: var(--surface-soft); border-right: 1px solid var(--line); }
  .section-label { width: min(100%, 590px); margin-bottom: 18px; color: var(--muted); font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .tweet-status-bar {
    width: min(100%, 590px);
    margin-bottom: 14px;
    padding: 9px 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
    font-size: 13px;
    color: var(--muted);
    box-sizing: border-box;
  }
  .tweet-status-spinner {
    width: 14px;
    height: 14px;
    border: 2px solid var(--line);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: tweet-spin .8s linear infinite;
    flex-shrink: 0;
  }
  .tweet-status-text {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tweet-status-link {
    color: var(--accent);
    font-weight: 600;
    flex-shrink: 0;
    margin-left: auto;
    font-size: 13px;
  }
  .tweet-status-bar.is-failed .tweet-status-spinner {
    display: none;
  }
  .tweet-status-bar.is-loaded {
    display: none;
  }
  @keyframes tweet-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .tweet-status-spinner { animation: none; } }
  .detail-media {
    width: min(100%, 590px);
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #090a09;
    border: 1px solid var(--line);
    border-radius: 4px;
  }
  .detail-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .standalone-tweet { width: min(100%, 590px); min-height: 480px; display: grid; place-items: center; color: var(--muted); font-size: 14px; }
  .standalone-tweet.is-staging {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    z-index: -1;
  }
  .standalone-tweet :global(.twitter-tweet), .standalone-tweet :global(.twitter-tweet-rendered) { margin: 0 auto !important; }
  .detail-copy { padding: clamp(36px, 5vw, 72px) clamp(24px, 4vw, 52px); }
  .taxonomy { margin: 0 0 24px; color: var(--muted); font-size: 12px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; }
  .taxonomy a, dd a { color: var(--accent); } .taxonomy span { margin-inline: 7px; }
  .description { margin: 0 0 32px; font-size: clamp(20px, 2vw, 28px); font-weight: 580; line-height: 1.32; letter-spacing: -.035em; }
  .author { display: flex; align-items: center; gap: 12px; padding: 18px 0; border-block: 1px solid var(--line); }
  .author img { width: 44px; height: 44px; border-radius: 50%; background: var(--surface-soft); }
  .author strong, .author span { display: block; font-size: 14px; } .author span { margin-top: 3px; color: var(--muted); }
  dl { margin: 0; } dl > div { display: grid; grid-template-columns: 100px 1fr; padding: 14px 0; border-bottom: 1px solid var(--line); font-size: 12px; }
  dt { color: var(--muted); } dd { margin: 0; }
  @media (max-width: 820px) {
    .detail-layout { display: flex; flex-direction: column; }
    .detail-primary { min-height: 520px; padding: 24px 14px; border-right: 0; border-bottom: 1px solid var(--line); }
    .detail-copy { padding: 30px 18px 60px; }
  }
</style>

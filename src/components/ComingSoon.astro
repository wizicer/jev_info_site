---
import { Icon } from 'astro-icon/components';
const { name, description } = Astro.props as { name: string; description: string };
---

<main class="soon">
  <div class="construction-icon" aria-hidden="true"><Icon name="material-symbols:construction-rounded" size={32} /></div>
  <span>Coming soon</span>
  <h1>{name}</h1>
  <p>{description}</p>
</main>

<style>
  .soon { min-height: calc(100dvh - 180px); padding: clamp(48px, 6vw, 80px) max(16px, calc((100% - 1480px) / 2)); display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-start; }
  .construction-icon { width: 64px; height: 64px; margin-bottom: 24px; display: grid; place-items: center; border: 1px solid var(--line); background: var(--surface-soft); color: var(--accent); }
  span { color: var(--accent); font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; }
  h1 { margin: 12px 0; font-size: 32px; font-weight: 600; line-height: 1; letter-spacing: -.045em; }
  p { max-width: 520px; margin: 0; color: var(--muted); font-size: 14px; line-height: 1.5; }
</style>


---
import { getLocaleFromUrl, useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<dialog class="case-dialog" aria-labelledby="case-dialog-description">
  <button class="dialog-close" type="button" aria-label={t.useCases.closeDetails}>×</button>
  <article class="dialog-layout">
    <section class="dialog-primary" aria-label={t.useCases.originalPost}>
      <div class="dialog-primary-label">{t.useCases.originalPost}</div>
      <div class="tweet-status-bar" role="status">
        <span class="tweet-status-spinner" aria-hidden="true"></span>
        <span class="tweet-status-text">{t.useCases.loadingPost}</span>
        <a class="tweet-status-link" href="#" target="_blank" rel="noreferrer">{t.useCases.openOnX}</a>
      </div>
      <div class="dialog-media">
        <div class="dialog-placeholder">jev</div>
      </div>
      <div class="dialog-embed" aria-live="polite" hidden></div>
    </section>
    <aside class="dialog-side">
      <div class="dialog-info">
        <div class="dialog-taxonomy"></div>
        <p id="case-dialog-description" class="dialog-description"></p>
        <div class="dialog-author">
          <img alt="" width="42" height="42" />
          <div><strong></strong><span></span></div>
        </div>
        <dl>
          <div><dt>{t.useCases.published}</dt><dd class="dialog-date"></dd></div>
          <div><dt>{t.useCases.source}</dt><dd><a class="dialog-source" href="#" target="_blank" rel="noreferrer">{t.useCases.viewOriginalPost}</a></dd></div>
        </dl>
      </div>
    </aside>
  </article>
</dialog>

<style>
  .case-dialog {
    position: fixed; inset: 50% auto auto 50%; transform: translate(-50%, -50%);
    width: min(1160px, calc(100% - 40px)); height: min(780px, calc(100dvh - 40px));
    max-width: none; max-height: none; margin: 0; padding: 0; overflow: hidden;
    border: 1px solid var(--line); background: var(--surface); color: var(--ink);
    box-shadow: 0 25px 100px rgb(0 0 0 / .4);
  }
  .case-dialog::backdrop { background: rgb(8 9 8 / .7); backdrop-filter: blur(5px); }
  .dialog-close { position: absolute; z-index: 5; top: 12px; right: 14px; width: 40px; height: 40px; padding: 0; border: 1px solid var(--line); background: var(--surface); color: var(--ink); cursor: pointer; font-size: 26px; line-height: 1; }
  .dialog-layout { height: 100%; display: grid; grid-template-columns: minmax(520px, 1.55fr) minmax(320px, .75fr); }
  .dialog-primary { min-width: 0; padding: 26px; overflow: auto; display: flex; flex-direction: column; align-items: center; background: var(--surface-soft); border-right: 1px solid var(--line); }
  .dialog-primary-label { width: min(100%, 590px); margin-bottom: 14px; color: var(--muted); font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .tweet-status-bar {
    width: min(100%, 590px);
    margin-bottom: 14px;
    padding: 9px 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
    font-size: 13px;
    color: var(--muted);
    box-sizing: border-box;
  }
  .tweet-status-spinner {
    width: 14px;
    height: 14px;
    border: 2px solid var(--line);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: tweet-spin .8s linear infinite;
    flex-shrink: 0;
  }
  .tweet-status-text {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tweet-status-link {
    color: var(--accent);
    font-weight: 600;
    flex-shrink: 0;
    margin-left: auto;
    font-size: 13px;
  }
  .tweet-status-bar.is-failed .tweet-status-spinner {
    display: none;
  }
  .tweet-status-bar.is-loaded {
    display: none;
  }
  @keyframes tweet-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .tweet-status-spinner { animation: none; } }
  .dialog-side { min-width: 0; overflow: auto; }
  .dialog-media {
    position: relative;
    width: min(100%, 590px);
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #090a09;
    border: 1px solid var(--line);
    border-radius: 4px;
  }
  .dialog-media img { position: relative; width: 100%; height: 100%; object-fit: contain; display: block; }
  .dialog-placeholder { color: #30322f; font-size: 32px; font-weight: 750; letter-spacing: -.08em; }
  .dialog-embed { width: min(100%, 590px); display: grid; place-items: center; color: var(--muted); font-size: 12px; }
  .dialog-embed.is-staging {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    z-index: -1;
  }
  .dialog-embed :global(.twitter-tweet), .dialog-embed :global(.twitter-tweet-rendered) { margin: 0 auto !important; }
  .dialog-info { padding: 28px 28px 38px; overflow-wrap: anywhere; }
  .dialog-taxonomy { margin-bottom: 17px; color: var(--accent); font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .dialog-description { margin: 0 0 24px; font-size: clamp(17px, 1.6vw, 22px); line-height: 1.34; letter-spacing: -.025em; }
  .dialog-taxonomy :global(a) { color: var(--accent); }
  .dialog-taxonomy :global(span) { margin-inline: 7px; color: var(--muted); }
  .dialog-author { display: flex; align-items: center; gap: 12px; padding: 17px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .dialog-author img { width: 42px; height: 42px; border-radius: 50%; background: var(--surface-soft); }
  .dialog-author strong, .dialog-author span { display: block; font-size: 12px; }
  .dialog-author span { margin-top: 3px; color: var(--muted); }
  dl { margin: 0; }
  dl > div { display: grid; grid-template-columns: 85px 1fr; gap: 10px; padding: 13px 0; border-bottom: 1px solid var(--line); font-size: 12px; }
  dt { color: var(--muted); } dd { margin: 0; } .dialog-source { color: var(--accent); }
  @media (max-width: 800px) {
    .case-dialog { width: 100%; height: 100%; max-height: none; border: 0; }
    .dialog-layout { display: flex; flex-direction: column; overflow: auto; }
    .dialog-primary { flex: 0 0 auto; min-height: 480px; overflow: visible; border-right: 0; border-bottom: 1px solid var(--line); }
    .dialog-side { overflow: visible; }
    .dialog-close { position: fixed; top: 10px; right: 10px; }
  }
  @media (max-width: 520px) {
    .dialog-primary { min-height: 380px; padding: 62px 12px 20px; }
    .dialog-info { padding-inline: 18px; }
  }
</style>

---
---

<dialog class="case-dialog" aria-labelledby="case-dialog-description">
  <button class="dialog-close" type="button" aria-label="Close details">×</button>
  <article class="dialog-layout">
    <section class="dialog-primary" aria-label="Original post">
      <div class="dialog-primary-label">Original post</div>
      <div class="dialog-embed" aria-live="polite"></div>
      <div class="dialog-media" hidden><div class="dialog-placeholder">jev</div></div>
    </section>
    <aside class="dialog-side">
      <div class="dialog-info">
        <div class="dialog-taxonomy"></div>
        <p id="case-dialog-description" class="dialog-description"></p>
        <div class="dialog-author">
          <img alt="" width="42" height="42" />
          <div><strong></strong><span></span></div>
        </div>
        <dl>
          <div><dt>Published</dt><dd class="dialog-date"></dd></div>
          <div><dt>Source</dt><dd><a class="dialog-source" target="_blank" rel="noreferrer">View original post ↗</a></dd></div>
        </dl>
      </div>
    </aside>
  </article>
</dialog>

<style>
  .case-dialog {
    position: fixed; inset: 50% auto auto 50%; transform: translate(-50%, -50%);
    width: min(1160px, calc(100% - 40px)); height: min(780px, calc(100dvh - 40px));
    max-width: none; max-height: none; margin: 0; padding: 0; overflow: hidden;
    border: 1px solid var(--line); background: var(--surface); color: var(--ink);
    box-shadow: 0 25px 100px rgb(0 0 0 / .4);
  }
  .case-dialog::backdrop { background: rgb(8 9 8 / .7); backdrop-filter: blur(5px); }
  .dialog-close { position: absolute; z-index: 5; top: 12px; right: 14px; width: 40px; height: 40px; padding: 0; border: 1px solid var(--line); background: var(--surface); color: var(--ink); cursor: pointer; font-size: 26px; line-height: 1; }
  .dialog-layout { height: 100%; display: grid; grid-template-columns: minmax(520px, 1.55fr) minmax(320px, .75fr); }
  .dialog-primary { min-width: 0; padding: 26px; overflow: auto; display: flex; flex-direction: column; align-items: center; background: var(--surface-soft); border-right: 1px solid var(--line); }
  .dialog-primary-label { width: 100%; margin-bottom: 14px; color: var(--muted); font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .dialog-embed { width: min(100%, 590px); min-height: 360px; display: grid; place-items: center; color: var(--muted); font-size: 12px; }
  .dialog-embed :global(.twitter-tweet), .dialog-embed :global(.twitter-tweet-rendered) { margin: 0 auto !important; }
  .dialog-embed :global(.embed-loading) { display: grid; justify-items: center; gap: 9px; text-align: center; }
  .dialog-embed :global(.embed-loading > span) { width: 24px; height: 24px; margin-bottom: 4px; border: 2px solid var(--line); border-top-color: var(--accent); border-radius: 50%; animation: embed-spin .8s linear infinite; }
  .dialog-embed :global(.embed-loading strong) { color: var(--ink); font-size: 14px; font-weight: 650; }
  .dialog-embed :global(.embed-loading small) { color: var(--muted); font-size: 12px; }
  .dialog-embed :global(.embed-loading a) { margin-top: 5px; color: var(--accent); font-size: 12px; }
  @keyframes embed-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .dialog-embed :global(.embed-loading > span) { animation: none; } }
  .dialog-side { min-width: 0; overflow: auto; }
  .dialog-media { position: relative; width: 100%; aspect-ratio: 16 / 9; display: none; place-items: center; overflow: hidden; background: #090a09; }
  .case-dialog.tweet-failed .dialog-embed { display: none; }
  .case-dialog.tweet-failed .dialog-media { display: grid; }
  .dialog-media img, .dialog-media video { position: relative; width: 100%; height: 100%; object-fit: contain; display: block; }
  .dialog-placeholder { color: #30322f; font-size: 32px; font-weight: 750; letter-spacing: -.08em; }
  .dialog-info { padding: 28px 28px 38px; overflow-wrap: anywhere; }
  .dialog-taxonomy { margin-bottom: 17px; color: var(--accent); font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .dialog-description { margin: 0 0 24px; font-size: clamp(17px, 1.6vw, 22px); line-height: 1.34; letter-spacing: -.025em; }
  .dialog-taxonomy :global(a) { color: var(--accent); }
  .dialog-taxonomy :global(span) { margin-inline: 7px; color: var(--muted); }
  .dialog-author { display: flex; align-items: center; gap: 12px; padding: 17px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .dialog-author img { width: 42px; height: 42px; border-radius: 50%; background: var(--surface-soft); }
  .dialog-author strong, .dialog-author span { display: block; font-size: 12px; }
  .dialog-author span { margin-top: 3px; color: var(--muted); }
  dl { margin: 0; }
  dl > div { display: grid; grid-template-columns: 85px 1fr; gap: 10px; padding: 13px 0; border-bottom: 1px solid var(--line); font-size: 12px; }
  dt { color: var(--muted); } dd { margin: 0; } .dialog-source { color: var(--accent); }
  @media (max-width: 800px) {
    .case-dialog { width: 100%; height: 100%; max-height: none; border: 0; }
    .dialog-layout { display: flex; flex-direction: column; overflow: auto; }
    .dialog-primary { flex: 0 0 auto; min-height: 520px; overflow: visible; border-right: 0; border-bottom: 1px solid var(--line); }
    .dialog-side { overflow: visible; }
    .dialog-close { position: fixed; top: 10px; right: 10px; }
  }
  @media (max-width: 520px) {
    .dialog-primary { min-height: 430px; padding: 62px 12px 20px; }
    .dialog-info { padding-inline: 18px; }
  }
</style>

